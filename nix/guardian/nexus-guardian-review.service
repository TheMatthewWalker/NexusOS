[Unit]
Description=NexusOS Guardian review-only broker
Documentation=man:systemd.exec(5)
After=local-fs.target
ConditionPathExists=/var/lib/nexus-guardian/signing.key

[Service]
Type=simple
User=root
Group=root
UMask=0077
StateDirectory=nexus-guardian
StateDirectoryMode=0700
RuntimeDirectory=nexus-guardian
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/nexusos/scripts/guardian/root_approval_issuer.py serve --state-dir /var/lib/nexus-guardian --socket /run/nexus-guardian/review.sock --client-uid 0
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RemoveIPC=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/nexus-guardian /run/nexus-guardian
LimitNOFILE=64
TasksMax=16

[Install]
WantedBy=multi-user.target
