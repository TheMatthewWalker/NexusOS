# NixOS module for the NexusOS desktop: Hyprland running the Nexus shell
# (SpaceUI, ADR-003), Nexus Core for every user, and the system services the
# shell reads its real state from (audio, network, power).
{ config, lib, pkgs, ... }:
let
  cfg = config.services.nexus-desktop;
  # start-hyprland runs Hyprland under its watchdog, as Hyprland asks; started
  # directly, Hyprland shows a warning on every login.
  # The person's language, formats and time zone (Settings, Language and
  # region) are read from ~/.config/nexusos/region.env first: only these
  # names, and only values made of locale and time-zone characters.
  session = pkgs.writeShellScript "nexus-session" ''
    region="''${XDG_CONFIG_HOME:-$HOME/.config}/nexusos/region.env"
    if [ -r "$region" ]; then
      while IFS='=' read -r key value; do
        case "$key" in LANG|LANGUAGE|LC_TIME|LC_NUMERIC|LC_MONETARY|LC_PAPER|LC_MEASUREMENT|TZ) ;; *) continue ;; esac
        case "$value" in ""|*[!A-Za-z0-9_.@:/+-]*) continue ;; esac
        export "$key=$value"
      done < "$region"
    fi
    exec ${config.programs.hyprland.package}/bin/start-hyprland -- --config /etc/nexus/hyprland.conf
  '';
  hyprland = "${session}";
  terminal = cfg.apps.terminal or "kitty";
  files = cfg.apps.files or "thunar";
  hyprctl = "${config.programs.hyprland.package}/bin/hyprctl";
  hyprbars = pkgs.hyprlandPlugins.hyprbars;
  # Title bars with close, minimise and maximise (Desktop B). Minimise moves
  # the window to the hidden "minimized" workspace; clicking its planet on the
  # Nexus launcher brings it back.
  titleBarConfig = ''
    plugin = ${hyprbars}/lib/libhyprbars.so
    plugin {
      hyprbars {
        bar_height = 34
        bar_color = rgba(0c142aee)
        col.text = rgb(e3eaff)
        bar_text_font = Inter Medium
        bar_text_size = 10
        bar_text_align = center
        bar_buttons_alignment = left
        bar_padding = 14
        bar_button_padding = 8
        bar_part_of_window = true
        bar_precedence_over_border = true
        on_double_click = ${hyprctl} dispatch fullscreen 1
        hyprbars-button = rgb(ff8fa3), 13, , ${hyprctl} dispatch killactive
        hyprbars-button = rgb(3a4c80), 13, , ${hyprctl} dispatch movetoworkspacesilent special:minimized
        hyprbars-button = rgb(3a4c80), 13, , ${hyprctl} dispatch fullscreen 1
      }
    }
  '';
  # Started by Hyprland: hands the user manager Hyprland's environment (its
  # display, and the env settings below, which the shell reads), then starts
  # the shell's service for this Hyprland. After Hyprland itself restarts, a
  # shell still tied to the old display is replaced.
  shellSession = pkgs.writeShellScript "nexus-shell-session" ''
    ${pkgs.dbus}/bin/dbus-update-activation-environment --systemd --all
    ${pkgs.systemd}/bin/systemctl --user reset-failed nexus-shell.service
    ${pkgs.systemd}/bin/systemctl --user restart nexus-shell.service
    exec ${pkgs.systemd}/bin/systemctl --user start nexus-session.target
  '';
  # Nexus, Settings, apps and the rest of the shell's own windows.
  appBinds = ''
    bind = SUPER, Space, global, nexus:toggle
    bind = SUPER, I, global, nexus:settings
    bind = SUPER, A, global, nexus:apps
    bind = SUPER, C, global, nexus:code
    bind = SUPER, G, global, nexus:images
    bind = SUPER, S, global, nexus:search
    bind = SUPER, Tab, global, nexus:overview
    bind = SUPER SHIFT, slash, global, nexus:explain
    # Push-to-talk (Voice.qml): the microphone is open only while Super+V is held.
    bind = SUPER, V, global, nexus:talk
  '';
  hyprlandConf = pkgs.writeText "nexus-hyprland.conf" ''
    # Generated by services.nexus-desktop. Add your own settings with
    # services.nexus-desktop.extraHyprlandConfig.
    monitor = , preferred, auto, 1
    env = NEXUS_DESKTOP_APPS,/etc/nexus/desktop-apps.json
    # Absolute: Hyprland's exec-once does not get the login PATH.
    env = NEXUS_CLI,${config.services.nexus-core.package}/bin/nexus
    ${lib.optionalString cfg.reducedMotion "env = NEXUS_REDUCED_MOTION,1"}
    env = NEXUS_CORE_STEPS,${toString cfg.coreDetail}
    # Push-to-talk records and spoken replies play through PipeWire.
    env = NEXUS_PW_RECORD,${config.services.pipewire.package}/bin/pw-record
    env = NEXUS_PW_PLAY,${config.services.pipewire.package}/bin/pw-play
    # Game mode: the shell unloads the model and runs
    #   hyprctl --batch "keyword decoration:blur:enabled false ; keyword animations:enabled false"
    # while a fullscreen game is open, then restores blur (NEXUS_BLUR) and
    # animations (off only with reduced motion).
    env = NEXUS_GAME_MODE,${if cfg.gameMode.enable then "1" else "0"}
    ${lib.optionalString cfg.gameMode.anyFullscreen "env = NEXUS_GAME_ANY_FULLSCREEN,1"}
    env = NEXUS_HYPRCTL,${hyprctl}
    env = NEXUS_BLUR,${if cfg.blur then "1" else "0"}
    # Starting values for Settings, Desktop; the person's choices are kept in
    # ~/.config/nexusos/desktop.json and applied by the shell at login.
    env = NEXUS_WINDOWS,${cfg.windows}
    env = NEXUS_HYPRSUNSET,${pkgs.hyprsunset}/bin/hyprsunset
    env = NEXUS_BRIGHTNESSCTL,${pkgs.brightnessctl}/bin/brightnessctl
    env = NEXUS_LOCK,${config.programs.hyprlock.package}/bin/hyprlock --config /etc/nexus/hyprlock.conf
    env = NEXUS_TERMINAL,${terminal}
    env = NEXUS_KEYBOARD_LAYOUT,${cfg.keyboardLayout}
    # First-run setup: the Welcome window opens once, after the first login.
    ${lib.optionalString cfg.firstRun "env = NEXUS_FIRST_RUN,1"}
    # The shell runs as a user service, nexus-shell.service, so it comes back
    # after a crash. It logs to the journal: journalctl --user -t nexus-shell
    exec-once = ${shellSession}
    exec-shutdown = ${pkgs.systemd}/bin/systemctl --user --no-block stop nexus-session.target

    input {
      kb_layout = ${cfg.keyboardLayout}
      follow_mouse = 1
      # Laptop touchpads as most people expect them; Settings, Mouse and
      # touchpad changes these per person (DesktopSettings.qml).
      touchpad {
        tap-to-click = true
        natural_scroll = true
        disable_while_typing = true
        clickfinger_behavior = true
      }
    }
    # Three fingers sideways: the next or previous workspace.
    gesture = 3, horizontal, workspace
    general {
      gaps_in = 6
      gaps_out = 14
      border_size = 1
      col.active_border = rgba(86a8ffaa)
      col.inactive_border = rgba(2a3a6688)
      layout = dwindle
      # Drag a window's edge to resize it, as on Windows.
      resize_on_border = true
      extend_border_grab_area = 12
    }
    ${lib.optionalString cfg.titleBars titleBarConfig}
    decoration {
      rounding = 18
      blur {
        enabled = ${lib.boolToString cfg.blur}
      }
    }
    animations {
      enabled = ${lib.boolToString (!cfg.reducedMotion)}
    }
    misc {
      disable_hyprland_logo = true
      disable_splash_rendering = true
      background_color = rgb(04050c)
    }

    # Super+Space opens Nexus; Super+L locks; Super+Return opens a terminal.
    # Ctrl+Alt+T also opens one: a VM or remote desktop on Windows keeps the
    # Super key for itself.
    ${lib.optionalString (!cfg.live) appBinds}
    # The screen reader, on and off.
    bind = SUPER ALT, S, exec, ${pkgs.procps}/bin/pkill -x orca || ${pkgs.orca}/bin/orca --replace
    bind = SUPER, L, exec, ${config.programs.hyprlock.package}/bin/hyprlock --config /etc/nexus/hyprlock.conf
    bind = SUPER, Return, exec, ${pkgs.gtk3}/bin/gtk-launch ${terminal}
    bind = CTRL ALT, T, exec, ${pkgs.gtk3}/bin/gtk-launch ${terminal}
    ${lib.optionalString (!cfg.live) "bind = SUPER, E, exec, ${pkgs.gtk3}/bin/gtk-launch ${files}"}
    bind = SUPER, Q, killactive
    # As on Windows: Alt+Tab between windows, Super+D the desktop (an empty
    # workspace), Super+arrows snap a window to half the screen or maximise it,
    # and screenshots with Super+Shift+S (an area), Print (the screen) and
    # Alt+Print (the window), saved in Pictures, Screenshots, and copied.
    bind = ALT, Tab, cyclenext
    bind = ALT, Tab, bringactivetotop
    bind = ALT SHIFT, Tab, cyclenext, prev
    bind = ALT SHIFT, Tab, bringactivetotop
    bind = SUPER, D, workspace, empty
    # Ctrl+Shift+Esc: the task manager (Tasks.qml).
    bind = CTRL SHIFT, Escape, global, nexus:tasks
    # Super+Shift+V: clipboard history (Super+V is push-to-talk); Super+. emoji.
    bind = SUPER SHIFT, V, global, nexus:clipboard
    bind = SUPER, period, global, nexus:emoji
    bind = SUPER, left, exec, /run/current-system/sw/bin/nexus-snap left
    bind = SUPER, right, exec, /run/current-system/sw/bin/nexus-snap right
    bind = SUPER, up, exec, /run/current-system/sw/bin/nexus-snap up
    bind = SUPER, down, exec, /run/current-system/sw/bin/nexus-snap down
    bind = SUPER SHIFT, S, exec, /run/current-system/sw/bin/nexus-screenshot area
    bind = , Print, exec, /run/current-system/sw/bin/nexus-screenshot screen
    bind = ALT, Print, exec, /run/current-system/sw/bin/nexus-screenshot window
    # Volume, microphone and brightness keys: the shell changes them and shows
    # how much (OnScreen.qml); they repeat while held and work on the lock screen.
    bindel = , XF86AudioRaiseVolume, global, nexus:volup
    bindel = , XF86AudioLowerVolume, global, nexus:voldown
    bindl = , XF86AudioMute, global, nexus:mute
    bindl = , XF86AudioMicMute, global, nexus:micmute
    bindel = , XF86MonBrightnessUp, global, nexus:brightup
    bindel = , XF86MonBrightnessDown, global, nexus:brightdown
    # Media keys play, pause and skip in whichever app is playing.
    bindl = , XF86AudioPlay, exec, /run/current-system/sw/bin/playerctl play-pause
    bindl = , XF86AudioPause, exec, /run/current-system/sw/bin/playerctl play-pause
    bindl = , XF86AudioNext, exec, /run/current-system/sw/bin/playerctl next
    bindl = , XF86AudioPrev, exec, /run/current-system/sw/bin/playerctl previous
    bind = SUPER SHIFT, E, exit
    bind = SUPER, F, fullscreen
    bind = SUPER, M, fullscreen, 1
    bind = SUPER, T, togglefloating
    # Super+drag moves a window, Super+right-drag resizes it.
    bindm = SUPER, mouse:272, movewindow
    bindm = SUPER, mouse:273, resizewindow
    ${lib.concatMapStrings (n: ''
      bind = SUPER, ${toString n}, workspace, ${toString n}
      bind = SUPER SHIFT, ${toString n}, movetoworkspace, ${toString n}
    '') (lib.range 1 5)}
    ${cfg.extraHyprlandConfig}
  '';
  # The login screen: greeter.qml in cage, a kiosk compositor. If it cannot
  # start (it exits within seconds without anyone logging in), or it hangs
  # (its heartbeat file stops changing), the text greeter takes over, so a
  # broken login screen never locks anyone out.
  # Who the login screen shows lives in /etc/nexus/greeter.env, not in this
  # script: the script then ends up in greetd.toml the same on every computer,
  # so an install from the USB stick needs nothing built for it (building a
  # TOML file needs tools the stick does not carry).
  greeter = pkgs.writeShellScript "nexus-greeter-session" ''
    set -a; . /etc/nexus/greeter.env; set +a
    export NEXUS_GREETER_SESSION=${lib.escapeShellArg hyprland}
    runtime=''${XDG_RUNTIME_DIR:-$(${pkgs.coreutils}/bin/mktemp -d)}
    export XDG_CACHE_HOME="$runtime/cache"
    export WLR_NO_HARDWARE_CURSORS=1
    # greeter.qml rewrites this file every 5 seconds while it answers.
    export NEXUS_GREETER_HEARTBEAT="$runtime/nexus-greeter.alive"
    ${pkgs.coreutils}/bin/rm -f "$NEXUS_GREETER_HEARTBEAT"
    started=$(${pkgs.coreutils}/bin/date +%s)
    # Its messages go to the journal: journalctl -t nexus-greeter
    ${pkgs.systemd}/bin/systemd-cat -t nexus-greeter ${pkgs.cage}/bin/cage -s -m last -- ${cfg.shellPackage}/bin/nexus-greeter &
    pid=$!
    # The watchdog: a first heartbeat within ${toString cfg.greeter.startLimit} seconds (software
    # rendering in a virtual machine is slow), then one at least every 30.
    hung=""
    while kill -0 "$pid" 2>/dev/null; do
      ${pkgs.coreutils}/bin/sleep 5
      now=$(${pkgs.coreutils}/bin/date +%s)
      if [ -e "$NEXUS_GREETER_HEARTBEAT" ]; then
        last=$(${pkgs.coreutils}/bin/stat -c %Y "$NEXUS_GREETER_HEARTBEAT"); limit=30
      else
        last=$started; limit=${toString cfg.greeter.startLimit}
      fi
      if [ $(( now - last )) -gt "$limit" ] && kill -0 "$pid" 2>/dev/null; then
        hung=1
        echo "nexus-greeter stopped answering; using the text login" >&2
        kill "$pid" 2>/dev/null; ${pkgs.coreutils}/bin/sleep 3; kill -9 "$pid" 2>/dev/null
        break
      fi
    done
    wait "$pid"
    if [ -z "$hung" ] && [ $(( $(${pkgs.coreutils}/bin/date +%s) - started )) -gt 5 ]; then exit 0; fi
    [ -n "$hung" ] || echo "nexus-greeter did not start; using the text login" >&2
    exec ${pkgs.tuigreet}/bin/tuigreet --time --remember --cmd ${lib.escapeShellArg hyprland}
  '';
  # greetd changes an expired password (PAM's chauthtok) instead of refusing
  # the login; greeter.qml asks for the current and the new one. Upstream
  # greetd 0.10 stops at "pam_acct_mgmt: NEW_AUTHTOK_REQD".
  greetd = pkgs.greetd.overrideAttrs (old: {
    patches = (old.patches or [ ]) ++ [ ../patches/greetd-expired-password.patch ];
  });
  hyprlockConf = pkgs.writeText "nexus-hyprlock.conf" ''
    general {
      hide_cursor = false
    }
    background {
      color = rgb(04050c)
    }
    input-field {
      size = 320, 52
      position = 0, -40
      halign = center
      valign = center
      outer_color = rgb(2a3a66)
      inner_color = rgb(0b1222)
      font_color = rgb(e3eaff)
      placeholder_text = Password
    }
    label {
      text = $TIME
      color = rgb(e3eaff)
      font_size = 56
      position = 0, 80
      halign = center
      valign = center
    }
  '';
in
{
  # try-apps: nexus-try and bubblewrap, for Try it in Apps (services.nexus-desktop.tryApps).
  imports = [ ./core.nix ./try-apps.nix ];

  options.services.nexus-desktop = {
    enable = lib.mkEnableOption "the NexusOS desktop (Hyprland with the Nexus shell)";
    shellPackage = lib.mkOption {
      type = lib.types.package;
      default = pkgs.callPackage ../packages/nexus-shell.nix { };
      description = "Package providing nexus-shell.";
    };
    live = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        The installer's live session: the shell shows only Wi-Fi and Install
        (live.qml), with no Nexus, apps or Welcome setup, and the app shortcuts
        are left out.
      '';
    };
    autologinUser = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = null;
      description = "Log this user straight into the desktop at boot. Otherwise a login prompt is shown.";
    };
    apps = lib.mkOption {
      type = lib.types.attrsOf lib.types.str;
      default = { terminal = "kitty"; files = "thunar"; browser = "firefox"; };
      example = { terminal = "foot"; files = "org.gnome.Nautilus"; browser = "firefox"; };
      description = ''
        Desktop entry ids for the Nexus orbit roles: files, browser, terminal,
        studio, models and settings. A role left unset, or naming an app that is
        not installed, is shown as "Not installed".
      '';
    };
    installDefaultApps = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Install the default terminal (kitty) and file manager (Thunar).";
    };
    reducedMotion = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Freeze the Nexus core and app motion, and turn off Hyprland animations.";
    };
    coreDetail = lib.mkOption {
      type = lib.types.ints.between 8 64;
      default = 56;
      description = ''
        Samples per pixel through the Nova core's gas. Lower it (for example to
        20) on machines that render without a capable GPU; the core looks
        softer but stays responsive.
      '';
    };
    blur = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Hyprland background blur. Turn off on machines without a capable GPU.";
    };
    windows = lib.mkOption {
      type = lib.types.enum [ "floating" "tiling" ];
      default = "floating";
      description = ''
        How windows open: "floating" (they overlap and are moved by their title
        bar, as on Windows or macOS) or "tiling" (they fill the screen side by
        side). This is the starting value; each person can change it in
        Settings, Desktop.
      '';
    };
    greeter = {
      graphical = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = "The NexusOS login screen. Off, greetd shows the text login (tuigreet).";
      };
      user = lib.mkOption {
        type = lib.types.nullOr lib.types.str;
        default = null;
        description = "The person the login screen offers. Unset, it asks for a user name.";
      };
      startLimit = lib.mkOption {
        type = lib.types.ints.between 30 3600;
        default = 240;
        description = ''
          Seconds the login screen may take to show itself before the text
          login takes over. Once it is up it must answer every 30 seconds.
        '';
      };
      fullName = lib.mkOption {
        type = lib.types.str;
        default = "";
        description = "The name shown on the login screen.";
      };
    };
    titleBars = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Title bars with close, minimise and maximise buttons on every window (the hyprbars plugin).";
    };
    gameMode.enable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Game mode: while a fullscreen game is open (Steam and Proton titles,
        gamescope, Wine, common launchers and emulators), unload the local
        model to free its GPU memory, stop the launcher core and turn off
        Hyprland blur and animations. Everything comes back when the game
        closes; the model reloads on the next question.
      '';
    };
    gameMode.anyFullscreen = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Treat any fullscreen window as a game, except video players and
        browsers. Can also be switched at run time with
        `nexus-shell-ipc call nexus fullscreenIsGame true`.
      '';
    };
    firstRun = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Open the Welcome window once after each person's first login: it asks
        what the computer is mostly for and suggests apps and settings from the
        curated bundles (nix/bundles). It can be reopened from Settings, About.
      '';
    };
    keyboardLayout = lib.mkOption {
      type = lib.types.str;
      default = "us";
      description = "XKB keyboard layout for the desktop.";
    };
    extraHyprlandConfig = lib.mkOption {
      type = lib.types.lines;
      default = "";
      description = "Extra lines appended to the generated Hyprland configuration.";
    };
  };

  config = lib.mkIf cfg.enable {
    programs.hyprland.enable = true;
    programs.hyprlock.enable = true;
    services.nexus-core.enable = lib.mkDefault true;

    environment.etc."nexus/hyprland.conf".source = hyprlandConf;
    environment.etc."nexus/hyprlock.conf".source = hyprlockConf;
    environment.etc."nexus/desktop-apps.json".text = builtins.toJSON cfg.apps;
    environment.etc."nexus/greeter.env".text = ''
      NEXUS_GREETER_USER=${lib.escapeShellArg (if cfg.greeter.user == null then "" else cfg.greeter.user)}
      NEXUS_GREETER_NAME=${lib.escapeShellArg cfg.greeter.fullName}
      # The login screen types the password with the computer's layout (cage reads it).
      XKB_DEFAULT_LAYOUT=${lib.escapeShellArg cfg.keyboardLayout}
    '';
    # gtk3 provides gtk-launch; Settings uses hyprsunset (night light),
    # brightnessctl, lspci (About) and xdg-open (Open folder). Explain mode
    # points with slurp, takes the area's picture with grim and reads the
    # selected text with wl-paste (wl-clipboard).
    environment.systemPackages = [ cfg.shellPackage pkgs.gtk3 pkgs.hyprsunset pkgs.brightnessctl pkgs.pciutils pkgs.xdg-utils
                                   pkgs.orca pkgs.adwaita-icon-theme pkgs.grim pkgs.slurp pkgs.wl-clipboard pkgs.rsync
                                   # notify-send: scripts and terminal commands can notify too (Notifications.qml shows them).
                                   pkgs.libnotify
                                   # gdbus: the shell watches logind to lock the screen before sleep (Idle.qml).
                                   pkgs.glib.bin ]
      ++ lib.optionals cfg.installDefaultApps [ pkgs.kitty pkgs.thunar ];

    # The shell is Nexus, the top bar and the session's polkit agent (the
    # Guardian password prompt), so it is supervised: a crash brings it back
    # in a second, and only a crash loop (5 starts in 2 minutes) leaves it
    # stopped. Hyprland starts nexus-session.target (exec-once) and stops it
    # as it exits. Not graphical-session.target: that would also start
    # services NexusOS does not set up, such as hypridle.
    systemd.user.targets.nexus-session = {
      description = "NexusOS desktop session (Hyprland)";
    };
    systemd.user.services.nexus-shell = {
      description = "Nexus shell (Nexus, the top bar and the polkit agent)";
      partOf = [ "nexus-session.target" ];
      after = [ "nexus-session.target" ];
      wantedBy = [ "nexus-session.target" ];
      # Apps the shell opens find their programs: the login PATH, which
      # Hyprland's own environment does not have.
      enableDefaultPath = false;
      environment.PATH = lib.mkForce (lib.concatStringsSep ":" [
        "/run/wrappers/bin" "%h/.nix-profile/bin" "/etc/profiles/per-user/%u/bin"
        "/nix/var/nix/profiles/default/bin" "/run/current-system/sw/bin"
      ]);
      startLimitIntervalSec = 120;
      startLimitBurst = 5;
      serviceConfig = {
        ExecStart = "${cfg.shellPackage}/bin/${if cfg.live then "nexus-live-shell" else "nexus-shell"}";
        Restart = "on-failure";
        RestartSec = 1;
        # The apps the shell opened are the person's, not the shell's: a
        # restart replaces the shell and leaves them running.
        KillMode = "process";
        SyslogIdentifier = "nexus-shell";
      };
    };

    fonts.packages = [ pkgs.inter pkgs.jetbrains-mono ];
    fonts.fontconfig.defaultFonts.sansSerif = [ "Inter" ];
    # Terminals need a monospace font, or they fall back to Inter and space it out.
    fonts.fontconfig.defaultFonts.monospace = [ "JetBrains Mono" ];

    services.greetd = {
      enable = true;
      package = greetd;
      settings = {
        default_session.command = if cfg.greeter.graphical then "${greeter}"
          else "${pkgs.tuigreet}/bin/tuigreet --time --remember --cmd '${hyprland}'";
      } // lib.optionalAttrs (cfg.autologinUser != null) {
        initial_session = { user = cfg.autologinUser; command = hyprland; };
      };
    };

    # The system panel reads real state from these; each can be turned off,
    # and the panel then says the service is unavailable.
    services.pipewire = {
      enable = lib.mkDefault true;
      pulse.enable = lib.mkDefault true;
    };
    networking.networkmanager.enable = lib.mkDefault true;
    services.upower.enable = lib.mkDefault true;
    # Bring my stuff over: old drives are opened read-only with udisksctl, and copied with rsync.
    services.udisks2.enable = lib.mkDefault true;
    # Mac drives: HFS+ through the kernel's own hfsplus; APFS through the
    # linux-apfs-rw module, which is read-only unless mounted with
    # "readwrite", an option udisks is not allowed to pass (apfs_allow below).
    # Not apfs-fuse: it reads the raw disk, which needs root, and udisks and
    # polkit cannot hand that to a person. Move in picks the volume with vol=N
    # (the data volume holds /Users) and maps the files to the person (uid, gid).
    boot.supportedFilesystems.apfs = lib.mkDefault true;
    environment.etc."udisks2/mount_options.conf".text = ''
      [defaults]
      apfs_defaults=ro,uid=$UID,gid=$GID
      apfs_allow=ro,uid=$UID,gid=$GID,vol
    '';
    # Settings, Power: the power mode.
    services.power-profiles-daemon.enable = lib.mkDefault true;
    # Settings, Display: brightness for people in the video group, without root.
    services.udev.packages = [ pkgs.brightnessctl ];
    # Settings, Accessibility: the screen reader reads Qt (the desktop) and GTK apps through AT-SPI.
    services.gnome.at-spi2-core.enable = lib.mkDefault true;
    environment.sessionVariables.QT_LINUX_ACCESSIBILITY_ALWAYS_ON = "1";
  };
}
