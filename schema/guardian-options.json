{
  "schemaVersion": 1,
  "maxChanges": 10,
  "maxDescriptionLength": 500,
  "options": {
    "networking.networkmanager.enable": {
      "type": "bool",
      "risk": "review",
      "summary": "Network connection management"
    },
    "services.flatpak.enable": {
      "type": "bool",
      "risk": "review",
      "summary": "Flatpak application runtime"
    },
    "services.openssh.enable": {
      "type": "bool",
      "risk": "elevated",
      "elevatedWhen": true,
      "summary": "OpenSSH remote login server",
      "riskNote": "Enables remote access: opens port 22 in the firewall. Key-only: password and keyboard-interactive logins and root login are turned off, so add your public key to ~/.ssh/authorized_keys first.",
      "alsoSetWhenEnabled": {
        "services.openssh.settings.KbdInteractiveAuthentication": false,
        "services.openssh.settings.PasswordAuthentication": false,
        "services.openssh.settings.PermitRootLogin": "no"
      }
    },
    "services.printing.enable": {
      "type": "bool",
      "risk": "review",
      "summary": "CUPS printing service"
    }
  },
  "packages": {
    "summary": "Install a package from the system's pinned nixpkgs into environment.systemPackages",
    "risk": "review",
    "attrPattern": "[A-Za-z_][A-Za-z0-9_-]{0,63}(\\.[A-Za-z_][A-Za-z0-9_-]{0,63}){0,3}",
    "reservedWords": ["assert", "else", "if", "in", "inherit", "let", "or", "rec", "then", "with"]
  }
}
